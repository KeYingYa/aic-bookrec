# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/

# Model files
*.pth
*.txt

# Data outputs
*.parquet
*.json
*.csv
*.zip

# Logs and plots
logs/
plots/
models_output/
# `submissions/` used to be ignored as a whole, which meant the negations below
# could never take effect (git does not descend into an ignored directory), and
# the submission actually delivered was untracked. Ignore the contents instead.
submissions/*
!submissions/submission*.csv

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Keep essential data files
!DataLoad/*.csv
!DataLoad/*.json
!DataLoad/*.parquet
!id_mappings.json
!submission*.csv

# The content model is a local SentenceTransformer: without its config files
# (*.json, vocab.txt) the MyModule/ directory cannot be loaded at all. The
# blanket *.json / *.txt rules above excluded them, so a fresh clone could not
# even run `cli/preprocess.py`.
!MyModule/*.json
!MyModule/*.txt
!MyModule/**/*.json
!MyModule/**/*.txt

# Make sure the honest validation report and the fixed submission are tracked
!reports/validation.md
!submissions/submission_v2.csv
